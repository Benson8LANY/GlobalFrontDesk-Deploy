{
	email {$ACME_EMAIL}
	admin off
}

{$FQDN} {
	encode zstd gzip
	request_body {
		max_size 21MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:"
		-Server
	}

	handle /v1/* {
		reverse_proxy api:3003
	}
	handle /webhooks/* {
		reverse_proxy api:3003
	}
	handle /health/* {
		reverse_proxy api:3003
	}
	handle {
		reverse_proxy web:3000
	}
}
